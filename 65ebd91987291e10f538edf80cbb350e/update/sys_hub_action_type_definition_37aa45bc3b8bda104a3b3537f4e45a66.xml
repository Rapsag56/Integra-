        <value>(function execute(inputs, outputs) {&#13;
&#13;
  var currentID = inputs.currentRecord;&#13;
&#13;
  var currentRecord = new GlideRecord("x_asscs_allos_o2c_task");&#13;
  if (currentRecord.get(currentID)) {&#13;
&#13;
    var businessPartners = [];&#13;
&#13;
    var auxLocatario = new SAPintegraUtils().getDadosLocatario(currentRecord.request_item.sys_id);&#13;
    var locatario = {&#13;
      "BPNumber": auxLocatario.codigoSAPLocatario,&#13;
      "BPRoleCode": "TR0600"&#13;
    };&#13;
&#13;
    var auxFiador = new SAPintegraUtils().getDadosFiador(currentRecord.request_item.sys_id);&#13;
    var fiador = [];&#13;
    for (var u = 0; u &lt; auxFiador.length; u++) {&#13;
&#13;
      if (auxFiador[u].codigoSAPFiador) {&#13;
&#13;
        fiador.push({&#13;
          "BPNumber": auxFiador[u].codigoSAPFiador,&#13;
          "BPRoleCode": auxFiador[u].bpRole&#13;
        });&#13;
      }&#13;
    }&#13;
    businessPartners = [locatario, ...fiador];&#13;
&#13;
&#13;
    var grLucParent = new GlideRecord('x_asscs_allos_o2c_requested_item');&#13;
    grLucParent.addEncodedQuery('parent=' + currentRecord.request_item + '^cat_item=173567c3873775501ee364640cbb3572'); //Item LUC&#13;
    grLucParent.query();&#13;
&#13;
    if (grLucParent.next()) {&#13;
      var lucParentID = grLucParent.sys_id;&#13;
      var grLucTask = new GlideRecord('x_asscs_allos_o2c_task');&#13;
      grLucTask.addEncodedQuery('parent=' + lucParentID + '^order=2');&#13;
      grLucTask.query();&#13;
      if (grLucTask.next()) {&#13;
        var companyCode = grLucTask.variables.company_code.getDisplayValue();&#13;
      }&#13;
    }&#13;
  }&#13;
&#13;
&#13;
&#13;
&#13;
  var myObj = {&#13;
    "CompanyCode": companyCode,&#13;
    "ContractNumber": "10008214",&#13;
    "BusinessPartners": businessPartners&#13;
  }&#13;
&#13;
  &#13;
  &#13;
&#13;
  outputs.payload = myObj;&#13;
&#13;
})(inputs, outputs);&#13;
</value>
